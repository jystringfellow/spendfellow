# Environment variables for Spendfellow
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Legacy fallback supported by the app, but prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_supabase_anon_key

# Plaid API Configuration
PLAID_CLIENT_ID=your_plaid_client_id
# Default environment selected when opening the account-connection UI.
PLAID_ENV=sandbox

# Add secrets for each environment you want to connect or sync.
PLAID_SANDBOX_SECRET=your_plaid_secret_sandbox
# PLAID_DEVELOPMENT_SECRET=your_plaid_secret_development
PLAID_PRODUCTION_SECRET=your_plaid_secret_production

# Legacy fallback supported by the app for the currently selected PLAID_ENV,
# but prefer the environment-specific secrets above.
# PLAID_SECRET=your_plaid_secret_for_current_plaid_env

# Optional but recommended for OAuth institution flows. Local HTTP is useful for
# Sandbox/Development, but Production redirect URIs must be HTTPS. See
# DEPLOYMENT.md for Cloudflare Tunnel local testing notes.
PLAID_REDIRECT_URI=http://localhost:3000/accounts

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
