    "db:push:dry-run": "supabase db push --dry-run",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "type-check": "next typegen && tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
