    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@ui-sdk/core": "0.1.0-beta.3",
    "@ui-sdk/react": "0.1.0-beta.3",
    "date-fns": "^3.3.1",
    "fast-xml-parser": "^5.9.3",
    "jszip": "^3.10.1",
    "next": "^16.4.6",
    "plaid": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
